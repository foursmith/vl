{
  "reference": "vscode-textmate@9.3.2",
  "tokenColors": [
    {
      "scope": "variable",
      "settings": {
        "foreground": "#123456",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "source.go variable",
      "settings": {
        "foreground": "#abcdef"
      }
